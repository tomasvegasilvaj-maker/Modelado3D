# Diseño desde fotos y revisión visual (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
FABRICA_MODELO=claude-sonnet-5-5

# Tope de gasto de IA por pedido, en dólares. Al pasarlo, la fábrica deja de llamar a la IA y te pregunta.
FABRICA_TOPE_USD=2.5
# Precios por millón de tokens para estimar el costo (revisalos en la página de precios de Anthropic).
PRECIO_ENTRADA_MTOK=3
PRECIO_SALIDA_MTOK=15

# Contraseña para entrar a la web (déjala vacía en tu PC; ponela siempre si la publicás).
FABRICA_CLAVE=
